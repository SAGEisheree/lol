FROM Sailor s, Reserves r, Boats b
WHERE s.sid = r.sid AND r.bid = b.bid AND (b.color = 'red' OR b.color = 'green');
​SELECT s.sname
FROM Sailor s
WHERE EXISTS (
SELECT *
FROM Reserves r
WHERE r.sid = s.sid AND r.bid = 103
);
​SELECT s.sname
FROM Sailor s
WHERE NOT EXISTS (
SELECT b.bid
FROM Boats b
WHERE NOT EXISTS (
SELECT r.bid
FROM Reserves r
WHERE r.sid = s.sid AND r.bid = b.bid
)
);
​SELECT r.sid
FROM Reserves r, Boats b
WHERE r.bid = b.bid AND b.color = 'red'
EXCEPT
